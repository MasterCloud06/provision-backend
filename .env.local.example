# ─── Entorno LOCAL ─── tu computadora, base de datos en Docker (docker compose up -d)
# Copia este archivo como .env.local

PORT=3000
DATABASE_URL=postgres://provision:provision@localhost:5432/provision
DATABASE_SSL=false
JWT_SECRET=secreto-local-solo-para-esta-maquina
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
LOG_HTTP=true

# Usado solo por "npm run db:crear-admin" (crea la primera sucursal y el admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@provision.local
ADMIN_PASSWORD=CambiaEsto123
SUCURSAL_NOMBRE=Casa matriz
SUCURSAL_CODIGO=MAT

# ─── Tienda web ───
# Dirección de la tienda (provision-frontend): Stripe vuelve aquí después de pagar
TIENDA_URL=http://localhost:5173
# Sucursal que despacha los pedidos web (vacío = la primera)
TIENDA_SUCURSAL_CODIGO=
# Envío a domicilio en centavos (2000 = Bs 20)
TIENDA_COSTO_ENVIO=2000
TIENDA_MINUTOS_RESERVA=30
TIENDA_DIAS_RETIRO=3

# ─── Stripe ─── (vacío = solo "pago al retirar")
# Llaves de prueba: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONEDA=bob
STRIPE_TIPO_CAMBIO=1
