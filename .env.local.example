# ─── Entorno LOCAL ─── tu computadora, base de datos en Docker (docker compose up -d)
# Copia este archivo como .env.local

PORT=3000
DATABASE_URL=postgres://provision:provision@localhost:5432/provision
DATABASE_SSL=false
JWT_SECRET=secreto-local-solo-para-esta-maquina
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
LOG_HTTP=true

# Usado solo por "npm run db:crear-admin" (crea la primera sucursal y el admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@provision.local
ADMIN_PASSWORD=CambiaEsto123
SUCURSAL_NOMBRE=Casa matriz
SUCURSAL_CODIGO=MAT
