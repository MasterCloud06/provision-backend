# ─── Entorno de DESARROLLO ─── servidor compartido para probar antes de producción
# Copia este archivo como .env.desarrollo. Aquí NO hay valores por defecto: todo es obligatorio.

PORT=3000
# PostgreSQL 18.6 del servidor de desarrollo
DATABASE_URL=postgres://USUARIO:CONTRASEÑA@HOST:5432/provision_dev
DATABASE_SSL=true
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Orígenes del frontend de desarrollo, separados por coma
CORS_ORIGIN=https://dev.provision.bo
LOG_HTTP=true

ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUCURSAL_NOMBRE=Casa matriz
SUCURSAL_CODIGO=MAT

# ─── Tienda web ───
# Dirección de la tienda (provision-frontend): Stripe vuelve aquí después de pagar
TIENDA_URL=https://provision-frontend-c9mi.onrender.com
# Sucursal que despacha los pedidos web (vacío = la primera)
TIENDA_SUCURSAL_CODIGO=
# Envío a domicilio en centavos (2000 = Bs 20)
TIENDA_COSTO_ENVIO=2000
TIENDA_MINUTOS_RESERVA=30
TIENDA_DIAS_RETIRO=3

# ─── Stripe ─── (vacío = solo "pago al retirar")
# Llaves de prueba: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONEDA=bob
STRIPE_TIPO_CAMBIO=1

# ─── Cloudinary ─── fotos de productos (vacío = no se pueden subir fotos)
# Dashboard → Settings → API Keys → "API environment variable"
CLOUDINARY_URL=
