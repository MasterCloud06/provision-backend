{
  "name": "provision-backend",
  "version": "0.1.0",
  "description": "API de Provisión: inventario, caja, ventas y finanzas personales para ópticas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env APP_ENV=local tsx watch src/index.ts",
    "dev:desarrollo": "cross-env APP_ENV=desarrollo tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env APP_ENV=local node dist/index.js",
    "start:desarrollo": "cross-env APP_ENV=desarrollo node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:levantar": "docker compose up -d --wait",
    "db:detener": "docker compose down",
    "db:generate": "cross-env APP_ENV=local drizzle-kit generate",
    "db:migrate": "cross-env APP_ENV=local tsx src/db/migrate.ts",
    "db:migrate:desarrollo": "cross-env APP_ENV=desarrollo tsx src/db/migrate.ts",
    "db:crear-admin": "cross-env APP_ENV=local tsx src/db/crear-admin.ts",
    "db:crear-admin:desarrollo": "cross-env APP_ENV=desarrollo tsx src/db/crear-admin.ts",
    "db:studio": "cross-env APP_ENV=local drizzle-kit studio",
    "db:studio:desarrollo": "cross-env APP_ENV=desarrollo drizzle-kit studio",
    "start:render": "node dist/db/migrate.js && node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasterCloud06/provision-backend.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/MasterCloud06/provision-backend/issues"
  },
  "homepage": "https://github.com/MasterCloud06/provision-backend#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true
}
